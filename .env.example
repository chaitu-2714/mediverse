# ── MediVerse AI Environment Variables Template ────────────────────────

# Google Client Configuration (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT Session Encryption Configuration
JWT_SECRET=use-a-securely-generated-sha256-string-here
JWT_ALGORITHM=HS256

# Gemini Online LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=gemini

